# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/opendrivelab

# SUMO
SUMO_HOME=/usr/share/sumo

# Worker
POLL_INTERVAL=5
TELEMETRY_BATCH_SIZE=100

# API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8501

# Streaming / Kafka
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
SCHEMA_REGISTRY_URL=http://redpanda:8081

# S3-compatible object store (LocalStack for local dev)
S3_ENDPOINT=http://localstack:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=sopir-raw

# Telemetry sink: postgres | kafka
TELEMETRY_SINK=postgres

# Raw lake writer (Kafka -> Parquet -> S3)
LAKE_CONSUMER_GROUP=lake-writer
LAKE_BATCH_SIZE=200
LAKE_FLUSH_INTERVAL_SEC=5
# Comma-separated; defaults to all four source topics
# LAKE_TOPICS=sopir.sim.telemetry.v1,sopir.veh.can.v1,sopir.veh.gnss.v1,sopir.veh.events.v1

# Stream processor (Kafka -> windows -> silver tables)
# Kept separate from LAKE_CONSUMER_GROUP on purpose: the lake must keep
# ingesting even while silver is being rebuilt.
PROCESSOR_CONSUMER_GROUP=stream-processor
# A run window closes after this many seconds of quiet. There is no run_ended
# marker yet, so idle time is the only end-of-run signal.
PROCESSOR_IDLE_TIMEOUT_SEC=20
PROCESSOR_MAX_POLL_RECORDS=500
# Comma-separated; defaults to all five topics (four sources + DLQ)
# PROCESSOR_TOPICS=sopir.sim.telemetry.v1,sopir.veh.can.v1,sopir.veh.gnss.v1,sopir.veh.events.v1,sopir.dlq.v1

# Observability (backend, worker, lake_writer, stream_processor)
# Each service serves /metrics, /healthz, /readyz on this port. The port is the
# same everywhere because every container has its own network namespace. The
# backend is the exception: it serves these routes through FastAPI on 8000.
# Set METRICS_PORT=0 to keep collecting metrics but bind no listener.
METRICS_HOST=0.0.0.0
METRICS_PORT=9101
# Set false to disable the endpoints entirely (one-shot CLI runs).
OBSERVABILITY_ENABLED=true
# How often consumer lag is polled, in seconds. Floored at 1s.
LAG_REFRESH_SEC=10
# A service whose main loop has not checked in within this many seconds reports
# unalive on /healthz. Must exceed the longest expected poll interval.
HEARTBEAT_MAX_AGE_SEC=60
LOG_LEVEL=INFO
