FROM sopir-base:latest

WORKDIR /app

# The processor imports evaluation/ (pure metric functions) and backend/
# (SQLAlchemy models + session) alongside streaming/, so it needs more of the
# tree than the lake writer does.
COPY backend/ ./backend/
COPY evaluation/ ./evaluation/
COPY streaming/ ./streaming/
COPY schemas/ ./schemas/
COPY alembic.ini ./
COPY alembic/ ./alembic/

ENV PYTHONPATH=/app

CMD ["python", "-m", "streaming.processor"]
